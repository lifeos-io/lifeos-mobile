# Copy to .env (not committed). Restart Metro after a change: EXPO_PUBLIC_* values are inlined at build time.

# mock: the in-memory scenario, no backend. live: the services through the gateway, after signing in.
EXPO_PUBLIC_DATA=mock

# The gateway and the Keycloak realm. localhost works in the iOS Simulator; a phone needs the Mac's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_AUTH_URL=http://localhost:8180/realms/lifeos

# Identity providers the realm brokers, shown as buttons on the sign-in screen (comma-separated): google.
# Needs the provider set up in Keycloak (lifeos-infra/local/README.md, "Sign in with Google").
EXPO_PUBLIC_SIGN_IN_PROVIDERS=
